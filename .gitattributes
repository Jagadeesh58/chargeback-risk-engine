# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.sh text eol=lf
Makefile text eol=lf
LICENSE text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.db binary
*.sqlite binary
